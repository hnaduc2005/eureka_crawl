{
  "name": "eureka-crawl",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node vote-dashboard/scripts/dev.mjs",
    "build": "npm run build:vercel",
